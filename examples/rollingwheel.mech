// rollingwheel — a wheel rolling down a toothed incline (a rack on the frame), no slipping.
//
//   mech run examples/rollingwheel.mech --headless 1 --csv wheel.csv
//
// A uniform disc rolling down a slope of angle a accelerates at (2/3) g sin a  (1/(1 + I/(m r^2))
// with I = m r^2 / 2): 3.27 m/s^2 for a = 30 deg. Nothing holds the wheel's centre at the rack, so the
// mesh says `tangent`: it adds the row that keeps the pitch circle touching the pitch line.
mechanism rollingwheel {
  param a = 30                              // slope, degrees
  world { gravity: 9.81  step: 0.0005 }

  ground frame {
    anchor slope at (0, 0) dir (cos(a * pi / 180), sin(a * pi / 180))
  }

  body wheel {
    anchor C at (-0.02 * sin(a * pi / 180), 0.02 * cos(a * pi / 180))   // one radius above the slope
    mass: 1
    com: (-0.02 * sin(a * pi / 180), 0.02 * cos(a * pi / 180))          // a uniform disc: mass at the centre
    inertia: 0.5 * 1 * 0.02 * 0.02
  }
  gear tyre { radius: 0.02 } on wheel.C
  mesh tyre on frame.slope tangent
}
